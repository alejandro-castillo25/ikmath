{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.4.x",

  "services": {
    "frontend": {
        "root": "frontend/",
        "framework": "vite",
        "routes": [
          { "handle": "filesystem" },
          { "src": "/(.*)", "status": 404, "dest": "/404.html" }
        ]
      },
    "backend": {
      "root": "server/",
      "entrypoint": "index.ts",
      "framework": "hono"
    }
  },

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  
  "redirects": [
     {
       "source": "/ints.html",
       "destination": "/integrals.html",
       "permanent": true
     }
   ]
}
